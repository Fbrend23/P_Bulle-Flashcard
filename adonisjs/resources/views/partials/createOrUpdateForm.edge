{{ csrfField() }} <div class="field">
    @!component('components/input', { name: 'title', label: 'Titre', value:
    old('title' || (title ? deck.title : '')) })
</div>
<div class="field">
    @!component('components/textarea', { name: 'description', label: 'Description',
    value: old('description') || (description ? deck.description : '') })
</div>
<div class="radio">
    @!component('components/radio', {
    name: 'isPublished',
    label: 'Publier ?',
    value: old('isPublished'),
    options: [
    { value: '1', label: 'Oui' },
    { value: '0', label: 'Non' },
    ]
    })
</div>
<button type="submit">Enregistrer</button>