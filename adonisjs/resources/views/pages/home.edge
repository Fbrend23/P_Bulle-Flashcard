@component('components/layout', { title: 'Accueil' })
    <div class="row g-4">
        @each((deck, index) in decks)
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-truncate" title="{{deck.title}}">{{deck.title}}</h5>
                    <p class="card-text text-muted flex-grow-1">{{deck.description}}</p>
                    <div class="mt-3 text-end">
                        <a href="{{ route('deck.show', {deckId: deck.id})}}" class="btn btn-outline-primary btn-sm">Voir le deck</a>
                        {{-- <a href="#" class="btn btn-primary btn-sm">Jouer</a> --}}
                    </div>
                </div>
            </div>
        </div>
        @else
        <div class="col-12 text-center py-5">
            <p class="lead text-muted">Aucun deck public disponible.</p>
        </div>
        @end
    </div>
@endcomponent