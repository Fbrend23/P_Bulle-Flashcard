@component('components/layout', { title: 'Mes Decks' })
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">Mes Decks</h1>
        <a href="{{ route('deck.create') }}" class="btn btn-primary">
            + Nouveau Deck
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Titre</th>
                            <th scope="col">Description</th>
                            <th scope="col" class="text-end pe-4">Options</th>
                        </tr>
                    </thead>
                    <tbody>
                        @each(deck in decks)
                        <tr>
                            <td class="ps-4 fw-medium">{{deck.title}}</td>
                            <td>{{deck.description}}</td>
                            <td class="text-end pe-4">
                                <a href="{{ route('deck.show', {id: deck.id})}}" class="btn btn-sm btn-outline-info me-1" title="Voir">
                                    Voir
                                </a>
                                <a href="{{ route('deck.edit', {deckId: deck.id})}}" class="btn btn-sm btn-outline-warning me-1" title="Modifier">
                                    Modifier
                                </a>
                                <a href="{{ route('deck.destroy', {deckId: deck.id})}}" class="btn btn-sm btn-outline-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce deck ?')" title="Supprimer">
                                    Supprimer
                                </a>
                            </td>
                        </tr>
                        @else
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">
                                Vous n'avez aucun deck pour le moment.
                            </td>
                        </tr>
                        @end
                    </tbody>
                </table>
            </div>
        </div>
    </div>
@endcomponent