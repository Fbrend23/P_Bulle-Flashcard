<div class="mb-3">
    <label class="form-label d-block">{{ label }}</label>
    @each((option, index) in options)
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" id="{{ name }}{{ index }}" name="{{ name }}" value="{{ option.value }}" {{ option.value == (value || old(name)) ? 'checked' : '' }}>
        <label class="form-check-label" for="{{ name }}{{ index }}">{{ option.label }}</label>
    </div>
    @end

    @if(flashMessages.get('errors.' + name))
    <div class="text-danger small mt-1">
        {{ flashMessages.get('errors.' + name)[0] }}
    </div>
    @endif
</div>